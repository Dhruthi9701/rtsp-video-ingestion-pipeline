# Copy to `.env` and fill in. `.env` is git-ignored so credentials never get committed.
# URL-encode special characters in the password (e.g. "@" -> "%40").

RTSP_URL=rtsp://<user>:<password>@<camera-host>:554/Streaming/Channels/1001
CAMERA_NAME=cam01

# Optional overrides (take precedence over config/config.yaml)
# OUTPUT_WIDTH=640
# OUTPUT_HEIGHT=360
# SEGMENT_SECONDS=300
# TARGET_FPS=5
# OUTPUT_DIR=output
# LOG_LEVEL=INFO

# Any config key can also be overridden generically:
#   RTSP_INGESTOR__<SECTION>__<KEY>=value   e.g. RTSP_INGESTOR__RECONNECT__MAX_DELAY_S=60
